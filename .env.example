# ── AI brain (any OpenAI-compatible API). Empty = rule-based mode (still uses real on-chain data).
# Groq (free): https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# ── Optional: CoinGecko Demo API key (free) — raises the GeckoTerminal on-chain limit
# from ~5 to 30 calls/min, so charts and lists refresh faster. https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ── Optional backup AI (free Google Gemini key) — used automatically when Groq is rate-limited.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite   (tried in order)
